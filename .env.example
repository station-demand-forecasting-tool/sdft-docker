# Copy to .env and edit, or set the same names in your environment.
# Maintainers: prefer Doppler (`doppler run -- docker compose up -d`) instead of a committed .env.

# PostgreSQL superuser password (db container)
POSTGRES_PASSWORD=change_me

# RStudio Server password for user `rstudio` (ui container)
PASSWORD=change_me

# Host directory bind-mounted to /home/rstudio in the ui container
# Linux example: /sdft
# Windows example: c:/sdft
SDFT_HOST_DIR=/sdft
